        "echo_level": 1,
        "start_time": 0,
        "end_time": 1
    },
    "solver_settings": {
        "solver_type": "Static",
        "model_part_name": "Structure",
        "domain_size": 3,
        "echo_level": 1,
        "analysis_type": "non_linear",
